{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                }
            ],
            "windows": {
                "program": "${workspaceFolder}/bin/Debug/wizards1.exe",
                "miDebuggerPath": "gdb.exe"
            },
            "osx": {
                "program": "${workspaceFolder}/bin/Debug/wizards1",
                "MIMode": "lldb"
            },
            "linux": {
                "program": "${workspaceFolder}/bin/Debug/wizards1",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "preLaunchTask": "build debug"
        },
